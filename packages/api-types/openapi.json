    "/v1/age-verification": {
      "get": {
        "operationId": "age_status_v1_age_verification_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AgeStatusOut"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Age Status",
        "tags": [
          "age"
        ]
      }
    },
