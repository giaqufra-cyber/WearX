# Copia in .env per lo sviluppo locale. Mai valori reali di produzione qui.
WEARX_ENV=local
WEARX_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/wearx
WEARX_MIGRATION_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/wearx
WEARX_REDIS_URL=redis://localhost:6379/0
WEARX_MIN_APP_VERSION=0.1.0
WEARX_VOTE_PEPPER=local-only-not-a-secret
# Progetto Supabase (regione West EU, Irlanda). Solo l'URL pubblico: la chiave service_role
# e la password del database NON vanno mai in questo file né nel repository.
# Per lo sviluppo con un Supabase locale: http://localhost:54321
WEARX_SUPABASE_URL=https://alcpqfphwygpktrcyauu.supabase.co
# Verifica dell'età: "fake" = fornitore di prova (vietato in produzione).
WEARX_AGE_PROVIDER=fake
WEARX_AGE_WEBHOOK_SECRET=local-only-age-webhook
# Indirizzo dell'API visto dal telefono (serve alla pagina del fornitore di prova),
# es. http://192.168.1.23:8000 quando provi con Expo Go sulla stessa rete Wi-Fi.
WEARX_PUBLIC_API_URL=http://localhost:8000
