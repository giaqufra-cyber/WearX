# Copia in .env per lo sviluppo locale. Mai valori reali di produzione qui.
WEARX_ENV=local
WEARX_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/wearx
WEARX_MIGRATION_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/wearx
WEARX_REDIS_URL=redis://localhost:6379/0
WEARX_MIN_APP_VERSION=0.1.0
WEARX_VOTE_PEPPER=local-only-not-a-secret
